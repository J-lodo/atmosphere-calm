# Copier ce fichier vers .env et remplir les valeurs
NODE_ENV=production
PORT=5000

# MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/atmosphere

# Secret JWT (minimum 32 caractères, générer une valeur aléatoire forte)
JWT_SECRET=changez-moi-avec-une-cle-secrete-longue-et-aleatoire

# Compte admin initial (créé une seule fois au premier démarrage)
ADMIN_EMAIL=admin@calm.com
ADMIN_PASSWORD=Admincalm20

# Origines CORS autorisées (séparées par des virgules)
# Laisser vide si le frontend est servi par ce même serveur (monolithe)
# ALLOWED_ORIGINS=https://votredomaine.com,https://www.votredomaine.com

# Cloudinary (optionnel) - si défini, les uploads audio seront envoyés sur Cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=atmosphere/audio

# Autoriser l'inscription publique via /api/auth/register (déconseillé en prod)
# ALLOW_PUBLIC_REGISTER=false

# Visiteurs (admin) — IP réelle du client derrière un proxy.
# Nombre de proxys de confiance devant l'API ; X-Forwarded-For n'est lu que derrière eux.
# Render : 1 (valeur par défaut en production). En local, défaut « loopback » (proxy CRA).
# Vérifier après déploiement : GET /api/visitors/ip-check (admin connecté).
# TRUST_PROXY=1
# Durée de conservation des visiteurs, en jours (défaut 90)
# VISITOR_RETENTION_DAYS=90
# Contact envoyé à Nominatim (géocodage inverse GPS) dans le User-Agent
# NOMINATIM_CONTACT=contact@votredomaine.com
